@startuml pulso-estados-meta
' Pulso — Estados: Meta Financeira
' Versão: 2.0 (TI5) | Data: 2026-08-29

[*] --> ATIVA : criar meta

ATIVA --> PAUSADA : pausar
PAUSADA --> ATIVA : retomar

ATIVA --> CONCLUIDA : valorAtual >= valorAlvo\nou concluir manualmente
PAUSADA --> CONCLUIDA : atingir valor alvo

ATIVA --> CANCELADA : cancelar
PAUSADA --> CANCELADA : cancelar

CONCLUIDA --> [*]
CANCELADA --> [*]

note right of CONCLUIDA
  concluidaEm preenchido
  Notificação META_ATINGIDA
end note

@enduml

@startuml pulso-estados-divida
' Pulso — Estados: Dívida / Empréstimo

[*] --> ABERTA : registrar dívida

state ABERTA {
  [*] --> PARCIAL : pagamento parcial
  PARCIAL --> PARCIAL : novo pagamento
  PARCIAL --> QUITADA : saldo = 0
  [*] --> QUITADA : quitar integral
}

ABERTA --> QUITADA : quitar total
QUITADA --> [*]

note right of ABERTA
  quitada = false
  saldo = valor - soma(pagamentos)
end note

@enduml

@startuml pulso-estados-lembrete
' Pulso — Estados: Lembrete

[*] --> PENDENTE : criar lembrete

PENDENTE --> PAGO : marcar como pago
PENDENTE --> VENCIDO : dataVencimento < hoje\n&& !pago
VENCIDO --> PAGO : marcar como pago

PAGO --> [*]

state PENDENTE {
  PENDENTE : sincronizado Google?\n(googleEventId — Premium)
}

note bottom of PENDENTE
  Job de recorrência mensal
  gera novo lembrete quando
  repetirMensal = true
end note

@enduml

@startuml pulso-estados-transacao-recorrente
' Pulso — Estados: Transação Recorrente

[*] --> MESTRE : criar com recorrente=true

MESTRE --> MESTRE : editar regra RRULE
MESTRE --> OCORRENCIA_GERADA : job diário\ngerar lançamento filho
OCORRENCIA_GERADA --> OCORRENCIA_GERADA : editar ocorrência
MESTRE --> CANCELADA : excluir série\n(excluirFuturas=true)
OCORRENCIA_GERADA --> EXCLUIDA : excluir ocorrência

CANCELADA --> [*]
EXCLUIDA --> [*]

@enduml

@startuml pulso-estados-plano
' Pulso — Estados: Plano do usuário (TI5 freemium)

[*] --> FREE : cadastro

FREE --> PREMIUM : upgrade plano
PREMIUM --> FREE : downgrade\n(opcional / admin)

state FREE {
  FREE : Grupos bloqueados
  FREE : Viagens bloqueadas
  FREE : Google Calendar sync bloqueado
}

state PREMIUM {
  PREMIUM : Grupos + Socket.IO chat
  PREMIUM : Viagens completas
  PREMIUM : Sync Google Calendar
}

@enduml
