# ========================================
# 🔗 API
# ========================================
# Local (Vite proxy /api → :3333):
VITE_API_URL=http://localhost:3333/api
# Demo hospedada (web na Vercel + API no Render) — obrigatório no build:
# VITE_API_URL=https://sua-api.onrender.com/api
# (Cookies cross-site: API já usa SameSite=None + Secure em production)

# ========================================
# 🔐 GOOGLE OAUTH (só o Client ID — secret fica na API)
# ========================================
VITE_GOOGLE_CLIENT_ID=seu_client_id.apps.googleusercontent.com