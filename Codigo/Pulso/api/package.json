{
    "name": "pulso-api",
    "version": "1.0.0",
    "description": "API do Pulso — O pulso da sua vida financeira",
    "main": "src/server.js",
    "engines": {
        "node": ">=22.12.0"
    },
    "scripts": {
        "dev": "nodemon src/server.js",
        "start": "node src/server.js",
        "start:prod": "prisma migrate deploy && node src/server.js",
        "postinstall": "prisma generate",
        "test": "jest",
        "test:watch": "jest --watch",
        "test:coverage": "jest --coverage",
        "db:generate": "prisma generate",
        "db:refresh": "prisma migrate deploy && prisma generate",
        "db:migrate": "prisma migrate dev",
        "db:migrate:deploy": "prisma migrate deploy",
        "db:pull": "npx prisma db pull",
        "db:studio": "npx prisma studio",
        "db:seed": "node prisma/seed.js",
        "db:reseed-tester": "node scripts/reseed-tester.js",
        "lint": "eslint .",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "rabbit:check": "node scripts/check-rabbitmq.js",
        "email:test": "node scripts/send-test-email.js"
    },
    "prisma": {
        "seed": "node prisma/seed.js"
    },
    "keywords": [],
    "author": "",
    "license": "ISC",
    "type": "commonjs",
    "dependencies": {
        "@googleapis/calendar": "^9.8.0",
        "@googleapis/oauth2": "^5.0.1",
        "@neondatabase/serverless": "^0.9.5",
        "@prisma/adapter-neon": "^5.22.0",
        "@prisma/client": "5.22.0",
        "@vercel/blob": "^2.4.1",
        "amqplib": "^2.0.1",
        "axios": "^1.15.2",
        "bcryptjs": "^3.0.3",
        "cookie-parser": "^1.4.7",
        "cors": "^2.8.6",
        "crypto-js": "^4.2.0",
        "decimal.js": "^10.6.0",
        "dotenv": "^17.4.2",
        "express": "^5.2.1",
        "express-rate-limit": "^8.3.2",
        "express-session": "^1.18.1",
        "google-auth-library": "^10.5.0",
        "helmet": "^8.1.0",
        "jsonwebtoken": "^9.0.3",
        "multer": "^2.2.0",
        "node-cron": "^4.2.1",
        "nodemailer": "^10.0.13",
        "passport": "^0.7.0",
        "passport-google-oauth20": "^2.0.0",
        "passport-jwt": "^4.0.1",
        "pdfjs-dist": "^4.10.38",
        "prisma": "5.22.0",
        "socket.io": "^4.8.3",
        "winston": "^3.19.0",
        "ws": "^8.18.0",
        "xlsx": "^0.18.5",
        "zod": "^4.3.6"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "eslint": "^10.3.0",
        "eslint-config-prettier": "^10.1.8",
        "globals": "^17.5.0",
        "jest": "^30.4.2",
        "nodemon": "^3.1.14",
        "prettier": "^3.8.3",
        "supertest": "^7.2.2",
        "swagger-jsdoc": "^6.2.8",
        "swagger-ui-express": "^5.0.1"
    }
}
