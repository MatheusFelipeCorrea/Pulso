# ========================================
# 🔧 SERVIDOR
# ========================================
PORT=3333
NODE_ENV=development

# ========================================
# 🗄️ BANCO DE DADOS (Neon)
# ========================================
# DATABASE_URL → connection POOLER (host com "-pooler") — uso da API em runtime
# DIRECT_URL   → connection direta — migrations / db push / seed
#
# Exemplo Neon:
# DATABASE_URL=postgresql://user:pass@ep-xxx-pooler.sa-east-1.aws.neon.tech/neondb?sslmode=require
# DIRECT_URL=postgresql://user:pass@ep-xxx.sa-east-1.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=postgresql://user:password@host-pooler/database?sslmode=require
DIRECT_URL=postgresql://user:password@host/database?sslmode=require

# ========================================
# 🔑 JWT
# ========================================
JWT_SECRET=sua_chave_secreta_aqui
JWT_REFRESH_SECRET=sua_chave_refresh_aqui

# ========================================
# 🔐 GOOGLE OAUTH
# ========================================
GOOGLE_CLIENT_ID=seu_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=seu_client_secret
GOOGLE_CALLBACK_URL=http://localhost:3333/api/auth/google/callback
# Produção (mesma URL pública da API):
# GOOGLE_CALLBACK_URL=https://sua-api-publica.com/api/auth/google/callback
# OAuth do Google Calendar (cadastre esta URI no Google Cloud Console → Credenciais → URIs de redirecionamento)
# Se omitido, deriva de GOOGLE_CALLBACK_URL trocando /auth/google por /calendario/google
GOOGLE_CALENDAR_CALLBACK_URL=http://localhost:3333/api/calendario/google/callback
# GOOGLE_CALENDAR_CALLBACK_URL=https://sua-api-publica.com/api/calendario/google/callback

# Chave de criptografia (AES-256-GCM) dos tokens OAuth do Google Calendar em repouso.
# Gere com: openssl rand -hex 32
GOOGLE_TOKENS_ENCRYPTION_KEY=gere_uma_chave_hex_de_32_bytes_aqui

# ========================================
# 🤖 GOOGLE GEMINI (IA)
# ========================================
GEMINI_API_KEY=sua_api_key_aqui

# ========================================
# 📧 EMAIL (SMTP) — Mailtrap
# ========================================
# Guia rápido:
#   • SANDBOX (dev): emails NÃO chegam no Gmail — ficam na inbox do Mailtrap
#     mailtrap.io → Email Testing → Sandboxes → Integration → SMTP
#   • SENDING (real): emails chegam de verdade — precisa domínio verificado
#     mailtrap.io → Sending Domains → Integration → SMTP (Transactional)
#
# --- Opção A: SANDBOX (desenvolvimento) ---
# SMTP_HOST=sandbox.smtp.mailtrap.io
# SMTP_PORT=2525
# SMTP_USER=seu_username_do_sandbox
# SMTP_PASS=sua_password_do_sandbox
# SMTP_FROM=nao-responda@pulso.dev
#
# --- Opção B: ENVIO REAL (produção / teste no Gmail) ---
# SMTP_HOST=live.smtp.mailtrap.io
# SMTP_PORT=587
# SMTP_USER=api
# SMTP_PASS=seu_api_token_do_mailtrap
# SMTP_FROM=noreply@seudominio.com
#
SMTP_HOST=sandbox.smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USER=seu_username_sandbox
SMTP_PASS=sua_password_sandbox
SMTP_FROM=Pulso <nao-responda@seudominio.com>

# ========================================
# 🌐 CORS
# ========================================
# Várias origens separadas por vírgula (local + Vercel prod + preview)
CORS_ORIGIN=http://localhost:5173
# Ex.: http://localhost:5173,https://pulso.vercel.app,https://www.seudominio.com

# ========================================
# 🔗 FRONTEND URL (links de email, redirect OAuth, Google Calendar)
# ========================================
FRONTEND_URL=http://localhost:5173
# Produção (Vercel): https://seu-app.vercel.app

# ========================================
# 🌍 GEONAMES (busca de destinos — opcional)
# ========================================
# Cadastro gratuito: https://www.geonames.org/login
# Ative "Free Web Services" na conta e use o mesmo username abaixo.
# Sem credencial, o Pulso usa o catálogo interno (~230 destinos).
# GEONAMES_USERNAME=seu_username
# GEONAMES_BASE_URL=http://api.geonames.org

# ========================================
# ✈️ DUFFEL (cotação de passagens — recomendado)
# ========================================
# Cadastro: https://duffel.com/ → Dashboard → Developer test mode → criar token.
# Teste (duffel_test_...): grátis, mas preços NÃO são reais (Duffel Airways).
# Live (duffel_live_...): preços reais de mercado; pay-as-you-go após ativar a conta.
# Sem token, o Pulso usa estimativas regionais.
# DUFFEL_ACCESS_TOKEN=
# DUFFEL_BASE_URL=https://api.duffel.com
# DUFFEL_API_VERSION=v2

# ========================================
# ✈️ AMADEUS (legado — portal self-service encerra jul/2026)
# ========================================
# Usado só se Duffel não estiver configurado.
# AMADEUS_CLIENT_ID=
# AMADEUS_CLIENT_SECRET=
# AMADEUS_BASE_URL=https://test.api.amadeus.com

# ========================================
# ⏰ CRON (Vercel — jobs agendados)
# ========================================
# Gere com: openssl rand -hex 32
# A Vercel envia Authorization: Bearer <CRON_SECRET> nas rotas /api/cron/*
# Hobby: só 1 cron/dia — use cron-job.org em /api/cron/tick (20 min). Ver Documentacao/Modulos/Cron.md
CRON_SECRET=gere_um_secret_longo_aqui

# ========================================
# 📷 UPLOAD DE IMAGENS (Vercel Blob — produção)
# ========================================
# Dashboard Vercel → Storage → Blob → Create → copie o token
# Dev local usa pasta uploads/grupos/ sem token
# BLOB_READ_WRITE_TOKEN=
# URL pública da API (produção) — usada nos links de upload local
# API_PUBLIC_URL=https://seu-app.vercel.app